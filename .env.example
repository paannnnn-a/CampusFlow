# 默认 demo 不读取密钥。真实模型模式需要把本文件复制为 .env 后填写。
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
# 官方 OpenAI 新模型使用 responses；其他兼容服务按实际支持设为 chat_completions。
LLM_API_STYLE=responses
# 使用阿里云等支持该字段的 Chat Completions 服务时可填 false；Responses 留空。
LLM_ENABLE_THINKING=
# 不启用外部任务追踪，避免意外上传校园会话。
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false

